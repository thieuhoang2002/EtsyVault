<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EtsyVault.UI.ViewModels"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        x:Class="EtsyVault.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="EtsyVault - 1-Click Shop Backup &amp; Disaster Recovery"
        Width="920" Height="680"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto, *">
        <!-- Modern Top Header Bar -->
        <Border Grid.Row="0" Background="#1E1E1E" Padding="24,18" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="26" VerticalAlignment="Center" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="EtsyVault" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <TextBlock Text="Local-First Disaster Recovery &amp; Asset Backup" FontSize="12" Foreground="#888888" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Content="📖 API Guide" Command="{Binding OpenApiGuideCommand}"
                            Padding="12,6" Background="#2A2A2A" Foreground="#CCCCCC" CornerRadius="6" />
                    <Button Content="☕ Buy Me a Coffee" Command="{Binding OpenBuyMeACoffeeCommand}"
                            Padding="12,6" Background="#FFDD00" Foreground="#000000" FontWeight="Bold" CornerRadius="6" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area with Dynamic States -->
        <ScrollViewer Grid.Row="1" Padding="32">
            <StackPanel MaxWidth="800" Spacing="24" HorizontalAlignment="Stretch">

                <!-- STATE 1: Ready to Connect -->
                <StackPanel Spacing="20" IsVisible="{Binding CurrentState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AppState.ReadyToConnect}}">
                    <!-- Intro Hero Banner -->
                    <Border Background="#252526" CornerRadius="12" Padding="24" BorderBrush="#333333" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding StatusTitle}" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <TextBlock Text="{Binding StatusSubtitle}" FontSize="14" Foreground="#AAAAAA" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Connection Card -->
                    <Border Background="#1E1E1E" CornerRadius="12" Padding="28" BorderBrush="#2D2D30" BorderThickness="1">
                        <StackPanel Spacing="20">
                            <TextBlock Text="Configuration &amp; Credentials" FontSize="16" FontWeight="SemiBold" Foreground="#EEEEEE" />

                            <!-- Demo Mode Toggle -->
                            <Border Background="#2A2A2E" CornerRadius="8" Padding="16">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Test with Demo / Mock Store" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        <TextBlock Text="Simulate full backup of 25 products &amp; 50 original photos offline (No Etsy API Key needed)."
                                                   FontSize="12" Foreground="#999999" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsDemoMode}" />
                                </Grid>
                            </Border>

                            <!-- Keystring Input (Shown when Demo Mode is OFF) -->
                            <StackPanel Spacing="8" IsVisible="{Binding !IsDemoMode}">
                                <TextBlock Text="Etsy Keystring (Client ID)" Foreground="#CCCCCC" />
                                <TextBox Text="{Binding Keystring}" PlaceholderText="Paste your Etsy Keystring (e.g. abcd1234efgh5678)"
                                         Height="40" CornerRadius="6" VerticalContentAlignment="Center" />
                                <TextBlock Text="Your Keystring stays 100% on this computer. Never transmitted to third-party servers."
                                           FontSize="11" Foreground="#777777" />

                                <!-- Advanced Settings (Optional Shared Secret) -->
                                <Expander Header="⚙️ Advanced Settings (Optional)" Margin="0,8,0,0"
                                          Background="#252528" CornerRadius="6" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="8" Margin="8">
                                        <TextBlock Text="Etsy Shared Secret (Optional for PKCE)" Foreground="#AAAAAA" FontSize="12" />
                                        <TextBox Text="{Binding SharedSecret}" PasswordChar="●"
                                                 PlaceholderText="Leave empty unless required by your Etsy app setup"
                                                 Height="36" CornerRadius="6" VerticalContentAlignment="Center" />
                                        <TextBlock Text="By default, Etsy API v3 uses PKCE and does not require a Shared Secret for desktop apps."
                                                   FontSize="11" Foreground="#666666" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <!-- Start Button -->
                            <Button Content="🚀 Start Full Backup" Command="{Binding StartBackupCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Height="48" FontSize="16" FontWeight="SemiBold"
                                    Background="#0078D4" Foreground="#FFFFFF" CornerRadius="8" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- STATE 2: Backing Up In Progress -->
                <StackPanel Spacing="20" IsVisible="{Binding CurrentState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AppState.BackingUp}}">
                    <Border Background="#1E1E1E" CornerRadius="12" Padding="24" BorderBrush="#2D2D30" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <TextBlock Text="{Binding StatusTitle}" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <TextBlock Text="{Binding StatusSubtitle}" Foreground="#AAAAAA" />

                            <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Height="10" CornerRadius="5" />
                            <TextBlock Text="{Binding ProgressText}" FontSize="13" Foreground="#0078D4" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- Realtime Logs Console -->
                    <Border Background="#141414" CornerRadius="8" Padding="16" BorderBrush="#222222" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Activity Logs" FontSize="13" FontWeight="SemiBold" Foreground="#888888" />
                            <ListBox ItemsSource="{Binding LogEntries}" Height="260" Background="Transparent"
                                     BorderThickness="0" Foreground="#A0A0A0" FontFamily="Consolas, Cascadia Code, monospace" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- STATE 3: Completed Successfully (The Donation Trigger) -->
                <StackPanel Spacing="20" IsVisible="{Binding CurrentState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AppState.Completed}}">
                    <Border Background="#1A2E1A" CornerRadius="12" Padding="28" BorderBrush="#2D5A2D" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="🎉 Backup Completed Successfully!" FontSize="24" FontWeight="Bold" Foreground="#4EFA6E" />
                            <TextBlock Text="Your shop catalog, images, and Shopify disaster recovery files are safely secured on your computer."
                                       FontSize="14" Foreground="#CCCCCC" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Metrics Summary Card -->
                    <Grid ColumnDefinitions="*, *, *">
                        <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="10" Padding="20" Margin="0,0,8,0" BorderBrush="#2D2D30" BorderThickness="1">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="📦 Listings Saved" FontSize="12" Foreground="#888888" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding SavedListingsCount}" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="10" Padding="20" Margin="4,0,4,0" BorderBrush="#2D2D30" BorderThickness="1">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="🖼️ Photos Downloaded" FontSize="12" Foreground="#888888" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding SavedImagesCount}" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#1E1E1E" CornerRadius="10" Padding="20" Margin="8,0,0,0" BorderBrush="#2D2D30" BorderThickness="1">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="🛍️ Disaster Formats" FontSize="12" Foreground="#888888" HorizontalAlignment="Center" />
                                <TextBlock Text="Excel + Shopify" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Donation & Folder Access Actions -->
                    <Border Background="#252528" CornerRadius="12" Padding="24" BorderBrush="#38383E" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <TextBlock Text="☕ Support Free &amp; Open-Source Development" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <TextBlock Text="EtsyVault is 100% free and open-source. If this tool saved you hours of manual work or brought you peace of mind, please consider buying the author a coffee to keep maintenance alive!"
                                       FontSize="13" Foreground="#BBBBBB" TextWrapping="Wrap" LineHeight="20" />

                            <Grid ColumnDefinitions="*, *">
                                <Button Grid.Column="0" Content="📂 Open Backup Folder" Command="{Binding OpenBackupFolderCommand}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Height="46" FontSize="15" FontWeight="SemiBold"
                                        Background="#0078D4" Foreground="#FFFFFF" CornerRadius="8" Margin="0,0,8,0" />

                                <Button Grid.Column="1" Content="☕ Buy Me a Coffee ($5)" Command="{Binding OpenBuyMeACoffeeCommand}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Height="46" FontSize="15" FontWeight="Bold"
                                        Background="#FFDD00" Foreground="#000000" CornerRadius="8" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Content="← Perform Another Backup" Command="{Binding ResetToReadyCommand}"
                            HorizontalAlignment="Center" Background="Transparent" Foreground="#888888" />
                </StackPanel>

                <!-- STATE 4: Error State -->
                <StackPanel Spacing="20" IsVisible="{Binding CurrentState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AppState.Error}}">
                    <Border Background="#3D1A1A" CornerRadius="12" Padding="24" BorderBrush="#6B2D2D" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="❌ Backup Interrupted" FontSize="20" FontWeight="Bold" Foreground="#FF6B6B" />
                            <TextBlock Text="{Binding StatusSubtitle}" Foreground="#EEEEEE" TextWrapping="Wrap" />
                            <Button Content="Try Again" Command="{Binding ResetToReadyCommand}"
                                    Background="#D83B01" Foreground="#FFFFFF" CornerRadius="6" Padding="16,8" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
